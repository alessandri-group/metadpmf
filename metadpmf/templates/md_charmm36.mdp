; Production MDP for Metadynamics - CHARMM36
; Generated by metadpmf when forcefield=charmm36.
; NSTEPS, TEMP and DT are filled in by metadpmf. DT defaults to 0.002 (2 fs)
; for CHARMM36; set mdp.dt in config.yaml only if you need a different timestep.
;
; Non-bonded settings follow the CHARMM36-in-GROMACS convention (MacKerell lab /
; CHARMM-GUI): Verlet scheme, force-switched VDW over 1.0-1.2 nm, PME, and
; NO dispersion correction (the force-switch already reproduces the CHARMM tail).
;
; References:
; - R.B. Best, et al., J. Chem. Theory Comput. 2012, DOI: 10.1021/ct300400x
; - J. Huang & A.D. MacKerell, J. Comput. Chem. 2013, DOI: 10.1002/jcc.23354

title                    = metadpmf metadynamics

; Integrator
integrator               = md
dt                       = DT
nsteps                   = NSTEPS
constraint_algorithm     = lincs             ; default
constraints              = h-bonds           ; constrain bonds involving hydrogens
lincs_order              = 4                 ; default

; Output Control
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 10000
nstenergy                = 10000
nstxout-compressed       = 10000             ; xtc, 20 ps (if dt = 2 fs)
compressed-x-precision   = 1000              ; default is 1000

; Some specific settings
pbc                      = xyz               ; default
periodic_molecules       = no                ; default
nstcomm                  = 100               ; default
comm_mode                = Linear

; Neighboring search and cutoff scheme
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.2

; Coulombic
coulombtype              = PME
rcoulomb                 = 1.2

; VDW  (CHARMM36 force-switch, 1.0-1.2 nm)
vdwtype                  = cut-off
rvdw                     = 1.2
vdw-modifier             = Force-switch
rvdw_switch              = 1.0
DispCorr                 = no                ; not used with CHARMM36 force-switch

; Temperature Coupling
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 1.0               ; ps
ref-t                    = TEMP
nsttcouple               = 20

; Pressure Coupling
Pcoupl                   = C-rescale
Pcoupltype               = isotropic
ref_p                    = 1.0
compressibility          = 5e-5              ; 1/bar
tau_p                    = 5.0               ; ps
nstpcouple               = 20

; Generate velocities from Maxwell-Boltzmann at start
gen_vel                  = yes
gen_temp                 = TEMP
gen_seed                 = -1                ; -1 = the seed is calculated from the process ID number
